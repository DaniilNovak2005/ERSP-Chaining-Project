# SAILOR Environment Configuration
# Copy to .env and fill in your keys

# LLM configuration (required)
export LLM_API_KEY=sk-your-openai-key-here
export LLM_API_BASE=https://api.openai.com/v1
export LLM_MODEL=gpt-5

# For DeepSeek experiments (optional)
# export LLM_API_KEY=your-deepseek-key-here
# export LLM_API_BASE=https://api.deepseek.com/v1
# export LLM_MODEL=deepseek-chat

# For B5 baseline (optional, requires Claude Code CLI)
# Run: claude login (requires Max plan)

# Pipeline configuration
export KLEE_TIMEOUT=300
export MAX_TURNS=60
export JOBS=128
